---
import { infoEs } from "@data";

import ProjectsWrapper from "@components/general/ProjectsWrapper.astro";
import MetaHead from "@components/general/MetaHead.astro";
import Layout from "@layouts/Layout.astro";

const Projects = infoEs.projects.map((project) => project);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <MetaHead
      title={"Proyectos"}
      description={"Todos los proyectos están disponibles en esta página."}
      ogImageUrl={"/assets/images/profile.png"}
    />
  </head>

  <body>
    <Layout lang="es">
      <h1 style="line-height: 1.2;">Proyectos</h1>
      <ProjectsWrapper projects={Projects} />
    </Layout>
  </body>
</html>
